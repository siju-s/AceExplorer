<?xml version="1.0" encoding="utf-8"?>
<resources>
   <color name="white">#FFFFFFFF</color>
   <color name="colorPrimary">#73066e</color>
    <color name="colorPrimaryDark">#800080</color>
    <color name="statusBarBackground">@color/colorPrimaryDark</color>
    <color name="toolbarBackground">@color/colorPrimary</color>
    <color name="navigationPathBackground">@color/colorPrimary</color>
   <color name="colorAccent">#FF4081</color>
   <color name="whiteOverlay">#F3F3F3</color>
   <color name="blue">#1e91d0</color>

   <color name="gallery_item_text_background">#30000000</color>
   <color name="bottom_toolbar_bg">@color/colorPrimary</color>
   <color name="fab_bg">#F3F3F3</color>
   <!--
     Dialog button labels. These sit on a white surface in the light theme and on a mid grey one in
     the dark theme, so they need a night variant: a single colour cannot clear 4.5:1 on both.
   -->
   <color name="dialogButtonColor">#73066e</color>
   <color name="dialogDestructiveColor">#C2185B</color>

   <color name="dialog_positive_color">@color/dialogButtonColor</color>
   <color name="dialog_neutral_color">@color/dialogButtonColor</color>
   <!-- Cancel is the safe action, so it uses the normal button colour, not the destructive one. -->
   <color name="dialog_negative_color">@color/dialogButtonColor</color>

   <color name="actionModeItemSelected">#33800080</color>


</resources>
